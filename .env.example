# Copie para .env e preencha. NUNCA commite o .env.
#
# Esta lista e a das variaveis que o codigo realmente le. Se voce adicionar uma
# aqui, ela precisa existir em algum os.getenv — variavel de exemplo que nao e
# lida por ninguem custa mais caro do que parece: alguem preenche, nada
# acontece, e a pessoa vai procurar o erro no lugar errado.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Obrigatoria: sem ela o processo nem sobe.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-um-segredo-longo-aleatorio
DEBUG=True
# Separados por virgula. Com DEBUG=False e obrigatoria.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Preferencia: DATABASE_URL primeiro (e como muito provedor entrega o banco),
# depois as variaveis separadas, e sem nenhuma delas cai no sqlite local.
# No Coolify quem manda sao as separadas: o MySQL sobe no proprio compose
# (docker-compose.prod.yml), com DB_HOST=db.
# DATABASE_URL=mysql://usuario:senha@host:3306/nome
DB_ENGINE=django.db.backends.mysql
DB_NAME=fechacaixa
DB_USER=root
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=3306

# So o docker-compose le esta. Tem que ser igual a DB_PASSWORD, senao o Django
# nao conecta no container. O compose aborta se estiver vazia.
MYSQL_ROOT_PASSWORD=12345

# ---------------------------------------------------------------------------
# Admin inicial
# ---------------------------------------------------------------------------
# O entrypoint roda "manage.py ensure_admin" no boot; sem estas duas o comando
# falha e o container sobe sem nenhum usuario. Ele e idempotente e REDEFINE a
# senha a cada restart — para trocar a senha do admin, mude aqui, nao pelo
# /admin (de la ela volta no proximo deploy).
DJANGO_SUPERUSER_EMAIL=admin@fechacaixa.local
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# ---------------------------------------------------------------------------
# CORS / CSRF (separados por virgula)
# ---------------------------------------------------------------------------
# Em producao o front chama a API pelo proprio dominio dele (/backend/...), e o
# Next reescreve. Ou seja: normalmente o navegador nao fala direto com o Django
# e o CORS nem entra em jogo. Preencha com a origem do front mesmo assim.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
# True faz as tasks rodarem dentro de quem as chamou. Nao ha worker em lugar
# nenhum — nem no docker-compose, nem no deploy —, e o unico .delay() vivo e o
# e-mail de "esqueci a senha", que cabe na propria requisicao.
#
# Deixar vazio aqui significa mandar esse e-mail para um broker que ninguem
# escuta: a pessoa que perdeu a senha espera para sempre, e nada aparece no
# log. Nos dois composes ja vem como True.
#
# CELERY_BROKER_URL e CELERY_RESULT_BACKEND sairam desta lista: o settings
# ainda as le (o Celery precisa de um endereco configurado), mas nada consulta
# esse endereco enquanto nao existir um worker. Se um dia voltar a existir,
# elas voltam junto.
CELERY_TASK_ALWAYS_EAGER=True

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# Com DEBUG=True os e-mails saem no console e nada abaixo e necessario.
# EMAIL_BACKEND so serve para forcar envio real com DEBUG=True (testar Gmail).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=FechaCaixa <no-reply@fechacaixa.local>

# Usada nos links que vao por e-mail (confirmar conta, definir senha). Aponte
# para o dominio publico do front, senao a pessoa recebe um link para localhost.
FRONTEND_URL=http://localhost:3000
